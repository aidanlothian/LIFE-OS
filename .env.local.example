# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Your timezone as an IANA name; drives "today", the 4am day boundary and calendar times
NEXT_PUBLIC_TIME_ZONE=America/Chicago

# Google OAuth (Calendar)
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Anthropic API key for the AI features (journal reading, quick add, daily newspaper, budget sorting)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Cloud Vision (legacy journal OCR)
GOOGLE_VISION_API_KEY=your-vision-api-key
