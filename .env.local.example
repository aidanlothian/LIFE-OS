# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Your timezone as an IANA name; drives "today", the 4am day boundary and calendar times
NEXT_PUBLIC_TIME_ZONE=America/Chicago

# Google OAuth (Calendar + Gmail)
GOOGLE_CLIENT_ID=your-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback

# Google Cloud Vision (reads photos of handwritten journal pages)
GOOGLE_VISION_API_KEY=your-vision-api-key

# Optional: Microsoft OAuth for Outlook mail
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/outlook/callback
